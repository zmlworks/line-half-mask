{
  "manifest_version": 3,
  "name": "行の半分マスク",
  "version": "0.6.0",
  "description": "横書きの文書で、奇数行の下半分と偶数行の上半分を白黒の斜め縞で覆います。縞は流れます。選択範囲だけにも、視覚増強の縞にも使えます。パソコンと Android の Firefox で動きます。",
  "browser_specific_settings": {
    "gecko": {
      "id": "line.half.mask@kofu.com",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "menus",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "96": "icon96.png",
    "128": "icon128.png"
  },
  "action": {
    "default_title": "行の半分マスク",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "96": "icon96.png"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "enhance.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-mask": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "マスクのオンオフ"
    },
    "swap-parity": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "塗りを入れ替え"
    }
  }
}
